# SEARCH32PAIR is a bounded legacy search/write operation.
FORMAT=2
GAME=BJWX

VARIANT=1
# SOURCE=2320 - Tak - Great Juju Challenge(EU).zip
IRQ32=00000238
IRQ32=00010990
END
