# SEARCH32PAIR is a bounded legacy search/write operation.
FORMAT=2
GAME=AWDE

VARIANT=1
# SOURCE=1050 - Wakeboarding Unleashed featuring Shaun Murray(EU).zip
IRQ32=00000298
END

