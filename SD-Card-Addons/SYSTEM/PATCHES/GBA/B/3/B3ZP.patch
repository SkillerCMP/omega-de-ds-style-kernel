# SEARCH32PAIR is a bounded legacy search/write operation.
FORMAT=2
GAME=B3ZP

VARIANT=1
# SOURCE=2356 - Global Star Sudoku Fever(EU).zip
IRQ32=00000228
IRQ32=00000424
END
