# SEARCH32PAIR is a bounded legacy search/write operation.
FORMAT=2
GAME=AGLC

VARIANT=1
# SOURCE=Tomato_Adventure_(Prototype,_iQue).zip
IRQ32=000001D0
IRQ32=003C22B0
END
