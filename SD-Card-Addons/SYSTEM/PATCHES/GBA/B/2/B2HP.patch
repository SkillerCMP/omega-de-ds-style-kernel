# SEARCH32PAIR is a bounded legacy search/write operation.
FORMAT=2
GAME=B2HP

VARIANT=1
# SOURCE=2197 - 2 Games in 1 - Hugo - Bukkazoom! + Hugo - The Evil Mirror Advance(EU).zip
